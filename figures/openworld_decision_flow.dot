digraph OpenWorldDecision {
  graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.45", ranksep="0.55",
         fontname="Helvetica", fontsize=16, splines=ortho];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#174A8B",
        fontcolor="#12345B", fontname="Helvetica", fontsize=12, penwidth=1.5,
        margin="0.14,0.09"];
  edge [color="#174A8B", fontname="Helvetica", fontsize=10, penwidth=1.5,
        arrowsize=0.7];

  query [label="Unlabeled query x"];
  encode [label="Current encoder\nmodel.encode(x)", color="#138276", fontcolor="#08675E"];
  scores [label="Cosine scores\nold prototypes + novel support bank", color="#138276", fontcolor="#08675E"];
  margin [label="Known/unknown\nadaptive margin", shape=diamond, width=1.35, height=0.85];
  known [label="Known-class\nprediction"];
  reject [label="Rejected candidate\nunknown stream", color="#E86D21", fontcolor="#B94A08"];
  cana [label="CANA\nCapacity-Aware Novel-Class Assignment", color="#E86D21", fontcolor="#B94A08"];
  support [label="5-shot support\nmodel.encode bank", color="#E86D21", fontcolor="#B94A08"];
  novel [label="Novel-class\nregistration + expansion"];
  metrics [label="AUROC / F1 / Inc / All\n(labels used only for reporting)", color="#59636E", fontcolor="#3E4750"];

  query -> encode -> scores -> margin;
  margin -> known [label="margin ≥ τ"];
  margin -> reject [label="margin < τ", color="#E86D21", fontcolor="#B94A08"];
  reject -> cana [label="label-free discovery", color="#E86D21", fontcolor="#B94A08"];
  cana -> support [label="support alignment", color="#E86D21", fontcolor="#B94A08"];
  support -> novel [label="top-k / temperature aggregation", color="#E86D21", fontcolor="#B94A08"];
  known -> metrics [style=dashed, color="#59636E"];
  novel -> metrics [style=dashed, color="#59636E"];
}
