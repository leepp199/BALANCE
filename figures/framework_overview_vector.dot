digraph FOWAC {
  graph [rankdir=TB, bgcolor="white", pad="0.15", nodesep="0.35", ranksep="0.65",
         fontname="Helvetica", fontsize=18, compound=true, splines=ortho];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#174A8B",
        fontcolor="#12345B", fontname="Helvetica", fontsize=12, penwidth=1.5,
        margin="0.13,0.08"];
  edge [color="#174A8B", fontcolor="#174A8B", fontname="Helvetica", fontsize=10,
        penwidth=1.5, arrowsize=0.7];

  subgraph cluster_offline {
    label="Offline Base Phase"; labelloc="t"; labeljust="l";
    color="#B9C3CF"; penwidth=1.2; style="rounded";
    base_audio [label="Labeled base audio"];
    encoder [label="ResNet-18\nwarm-up"];
    descriptors [label="Semantic embedding z\nStructure response h (layer 3/4)", color="#138276", fontcolor="#08675E"];
    global_cluster [label="Cross-sample\nglobal clustering", color="#138276", fontcolor="#08675E"];
    dfsb [label="LSRB\nLatent Structure Reference Bank\n(learn once, frozen)", color="#138276", fontcolor="#08675E"];
    base_loss [label="Semantic classification\n+ latent-structure consistency\nL_base = L_cls + λ_str L_LSRB"];
    {rank=same; base_audio; encoder; descriptors; global_cluster; dfsb; base_loss;}
    base_audio -> encoder -> descriptors;
    descriptors -> global_cluster [color="#138276"];
    global_cluster -> dfsb [label="learn once", color="#138276", fontcolor="#138276"];
    dfsb -> base_loss [label="frozen targets", color="#138276", fontcolor="#138276"];
  }

  subgraph cluster_online {
    label="Online Open-World Session t"; labelloc="t"; labeljust="l";
    color="#B9C3CF"; penwidth=1.2; style="rounded";
    stream [label="Mixed unlabeled stream"];
    features [label="Semantic embedding z\nStructural response h", color="#138276", fontcolor="#08675E"];
    known [label="Known / unknown\nmargin gate?", shape=diamond, width=1.25, height=0.8, margin=0.04];
    discovery [label="CANA\nCapacity-Aware Novel-Class Assignment\nlabel-free balanced discovery",
               color="#E86D21", fontcolor="#B94A08"];
    expansion [label="5-shot support bank\ncurrent model.encode\n(top-k / temperature aggregation)", color="#E86D21", fontcolor="#B94A08"];
    bank [label="Expanded classifier bank\nold prototypes + novel support bank"];
    {rank=same; stream; features; known; discovery; expansion; bank;}
    stream -> features -> known;
    known -> bank [label="yes: bypass discovery", constraint=false, minlen=3];
    known -> discovery [label="no: unknown", color="#E86D21", fontcolor="#E86D21"];
    discovery -> expansion [label="balanced slots", color="#E86D21", fontcolor="#E86D21"];
    expansion -> bank [color="#E86D21"];
  }

  subgraph cluster_memory {
    label="Exemplar-Free Uncertainty Memory"; labelloc="t"; labeljust="l";
    color="#B9C3CF"; penwidth=1.2; style="rounded";
    memory [label="Exemplar-free uncertainty memory\nM_c = (μ_c, v_c, n_c, ρ_c)"];
    reliable [label="Reliable?\nbase acc ≥ 0.7\nmean var ≥ 10⁻⁴", shape=diamond, margin=0.06];
    skip [label="Skip replay\nkeep prototypes", color="#E86D21", fontcolor="#B94A08"];
    replay [label="Hard statistical\nreplay"];
    anchor [label="Confidence\nanchor"];
    residual [label="Bounded residual\nwrite-back"];
    outcome [label="Retain old classes  |  Learn novel classes\nstability                         plasticity"];
    next [label="Session t+1", color="#138276", fontcolor="#08675E"];
    {rank=same; memory; reliable; skip; replay; anchor; residual; outcome; next;}
    memory -> reliable;
    reliable -> skip [label="no", color="#E86D21", fontcolor="#E86D21"];
    reliable -> replay [label="yes"];
    replay -> anchor -> residual -> outcome -> next;
    skip -> next [color="#E86D21"];
  }

  dfsb -> features [label="shared LSRB reference", color="#138276", fontcolor="#138276", ltail=cluster_offline, lhead=cluster_online];
  bank -> memory [label="class moments", ltail=cluster_online, lhead=cluster_memory];
  next -> stream [label="continual loop", color="#138276", fontcolor="#138276", constraint=false];
}
